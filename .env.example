DATABASE_URL="postgresql://..."
DIRECT_URL="postgresql://..."
APP_URL="http://localhost:3000"
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
AUTH_SECRET=""
# Dedicated key for bank account number AES encryption at rest (defaults to hash of AUTH_SECRET if unset)
BANK_ENCRYPTION_KEY=""
# Milestone validity release cron job secret (required in Authorization: Bearer <secret>)
CRON_SECRET=""
SENTRY_DSN=""
# Browser error monitoring. A Sentry DSN is public; never place a Sentry auth token here.
NEXT_PUBLIC_SENTRY_DSN=""
# Required in production. Allow only the public web application's origin for Socket.IO.
REALTIME_ALLOWED_ORIGIN="http://localhost:3000"
# Use `local` only for development. Production requires the S3-compatible values below.
FILE_STORAGE_PROVIDER="local"
FILE_STORAGE_BUCKET=""
FILE_STORAGE_REGION=""
FILE_STORAGE_ENDPOINT=""
FILE_STORAGE_FORCE_PATH_STYLE="false"
FILE_STORAGE_ACCESS_KEY_ID=""
FILE_STORAGE_SECRET_ACCESS_KEY=""
# Required only to create the first administrator in a new database.
ADMIN_BOOTSTRAP_USERNAME=""
ADMIN_BOOTSTRAP_PASSWORD=""
# Phone OTP provider. Keep "development" until Twilio Verify is configured; set to "twilio" to send real SMS.
PHONE_OTP_PROVIDER="development"
# Development/Preview only. Never expose this value to the browser.
DEV_PHONE_OTP="2412"
# Twilio Verify credentials. Server-only; never prefix with NEXT_PUBLIC_.
# Account SID/Auth Token from Console > Account > Account Info (Account SID must start with "AC").
# Verify Service SID from Console > Verify > Services (starts with "VA"); set its code length to 4.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
TWILIO_VERIFY_SERVICE_SID=""
TWILIO_MESSAGING_SERVICE_SID=""
# Reserved for a future SMS provider. Do not use NEXT_PUBLIC_ prefixes for these secrets.
SMS_API_KEY=""
SMS_API_SECRET=""
SMS_SENDER_ID=""
SMS_API_URL=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
# Server key for address geocoding. Restrict this key by server IP in production.
GOOGLE_MAPS_SERVER_KEY=""
NEXT_PUBLIC_GOOGLE_MAPS_JS_ENABLED="true"
PERSONA_ENABLED="false"
PERSONA_API_KEY=""
PERSONA_TEMPLATE_ID=""
PERSONA_WEBHOOK_SECRET=""
# AuthBridge Indian Identity Verification (Aadhaar / PAN)
AUTHBRIDGE_ENABLED="false"
AUTHBRIDGE_API_KEY=""
AUTHBRIDGE_CLIENT_ID=""
AUTHBRIDGE_API_URL="https://api.authbridge.com/v1"
AUTHBRIDGE_WEBHOOK_SECRET=""
# SpringVerify Background Verification (BGV - Police & Criminal Record Check)
SPRINGVERIFY_ENABLED="false"
SPRINGVERIFY_API_KEY=""
SPRINGVERIFY_API_URL="https://api.springverify.com/v1"
SPRINGVERIFY_WEBHOOK_SECRET=""
# Use Test Mode credentials locally. The key ID must begin with rzp_test_.
RAZORPAY_ENABLED="true"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Configure this same secret in Razorpay Dashboard > Webhooks.
RAZORPAY_WEBHOOK_SECRET=""
# Keep false until Razorpay Route Linked Accounts and payout permissions are approved.
RAZORPAY_ROUTE_ENABLED="false"
# RazorpayX automated payouts (IMPS / UPI)
# RazorpayX current account number (e.g. 232323... from RazorpayX Dashboard)
RAZORPAYX_ACCOUNT_NUMBER=""
# Optional dedicated RazorpayX API key & secret if distinct from standard checkout keys
RAZORPAYX_KEY_ID=""
RAZORPAYX_KEY_SECRET=""

# --- Local development / tooling only (not used in production) ---
# Disposable database for the test suite. MUST differ from DATABASE_URL:
# the safety guard refuses to run when they match.
TEST_DATABASE_URL=""
# Used by `prisma migrate dev` to diff the schema. Needed when the database
# role lacks CREATEDB.
SHADOW_DATABASE_URL=""
# Set to 1 to log and count every Prisma query while profiling. Slow; off by default.
DB_QUERY_LOG=""
# Dev server bind address and port (defaults: 0.0.0.0 and 3000).
HOSTNAME=""
PORT=""
# Set to 1 to run the dev server on webpack instead of Turbopack.
NEXT_WEBPACK=""
# Address used by admin tooling and notification fallbacks.
ADMIN_EMAIL=""
# Salt for approximate-location obfuscation on public professional profiles.
GEO_OBFUSCATION_SALT=""
# Set to true only to re-run the disabled legacy migration wrapper scripts.
ALLOW_LEGACY_MIGRATION_SCRIPT=""
