generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model CmsPage {
  id              Int           @id @default(autoincrement())
  title           String
  slug            String        @unique
  content         String        @default("")
  metaTitle       String        @default("") @map("meta_title")
  metaDescription String        @default("") @map("meta_description")
  status          CmsPageStatus @default(DRAFT)
  pageKey         String        @default("") @map("page_key")
  sections        String        @default("{}")
  keywords        String        @default("")
  ogTitle         String        @default("") @map("og_title")
  ogDescription   String        @default("") @map("og_description")
  ogImage         String        @default("") @map("og_image")
  canonicalUrl    String        @default("") @map("canonical_url")
  createdAt       DateTime      @map("created_at")
  updatedAt       DateTime      @map("updated_at")

  @@index([slug])
  @@index([status])
  @@map("cms_pages")
}

model CmsPageVersion {
  id        Int      @id @default(autoincrement())
  pageId    Int      @map("page_id")
  versionNo Int      @map("version_no")
  content   String
  createdBy Int?     @map("created_by")
  createdAt DateTime @map("created_at")

  @@unique([pageId, versionNo])
  @@index([pageId])
  @@map("cms_page_versions")
}

model CmsMedia {
  id        Int      @id @default(autoincrement())
  name      String
  mimeType  String   @map("mime_type")
  url       String
  createdBy Int?     @map("created_by")
  createdAt DateTime @map("created_at")

  @@index([createdAt])
  @@map("cms_media")
}

model SQLiteMigrationTableArchive {
  sourceTable String   @id @map("source_table")
  rows        Json
  sourceCount Int      @map("source_count")
  migratedAt  DateTime @default(now()) @map("migrated_at")
}

model SQLiteMigrationAudit {
  sourceTable   String   @id @map("source_table")
  sourceCount   Int      @map("source_count")
  archivedCount Int      @map("archived_count")
  migratedAt    DateTime @default(now()) @map("migrated_at")
}

model WebsitePage {
  pageKey   String        @id @map("page_key")
  path      String        @unique
  title     String
  content   String        @default("")
  status    CmsPageStatus @default(DRAFT)
  updatedAt DateTime      @map("updated_at")
  css       String        @default("")
}

model LegalPage {
  slug      String        @id @map("slug")
  title     String
  content   String        @default("")
  status    CmsPageStatus @default(PUBLISHED)
  updatedAt DateTime      @map("updated_at")
}

model ServiceCategory {
  id                Int               @id @default(autoincrement())
  name              String            @unique
  slug              String            @unique
  description       String            @default("")
  iconName          String            @default("") @map("icon_name")
  sortOrder         Int               @default(0) @map("sort_order")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @default(now()) @map("updated_at")
  segment           String            @default("RESIDENTIAL")
  parentId          Int?              @map("parent_id")
  services          Service[]
  parent            ServiceCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children          ServiceCategory[] @relation("CategoryHierarchy")
  professionalUsers User[]            @relation("ProfessionalPrimaryCategory")

  @@index([parentId])
}

model User {
  id                                  Int                       @id @default(autoincrement())
  role                                UserRole                  @default(CLIENT)
  firstName                           String                    @map("first_name")
  lastName                            String                    @map("last_name")
  email                               String                    @unique
  phone                               String?                   @unique
  passwordHash                        String?                   @map("password_hash")
  googleId                            String?                   @unique @map("google_id")
  avatarUrl                           String?                   @map("avatar_url")
  companyName                         String?                   @map("company_name")
  companyWebsite                      String?                   @map("company_website")
  industry                            String?
  teamSize                            String?                   @map("team_size")
  companyDescription                  String?                   @map("company_description")
  address                             String?
  professionalCategory                String?                   @map("professional_category")
  professionalCity                    String?                   @map("professional_city")
  professionalSkillsJson              String?                   @map("professional_skills_json")
  experienceYears                     Int?                      @map("experience_years")
  hourlyRate                          Int?                      @map("hourly_rate")
  fixedRate                           Int?                      @map("fixed_rate")
  portfolioUrl                        String?                   @map("portfolio_url")
  workPhotosJson                      String?                   @map("work_photos_json")
  certificationsJson                  String?                   @map("certifications_json")
  tradeLicenseUrl                     String?                   @map("trade_license_url")
  serviceArea                         String?                   @map("service_area")
  workMode                            String                    @default("both") @map("work_mode")
  serviceRadiusKm                     Int?                      @map("service_radius_km")
  averageRating                       Float                     @default(0) @map("average_rating")
  reviewCount                         Int                       @default(0) @map("review_count")
  isVerified                          Boolean                   @default(false) @map("is_verified")
  availabilityStatus                  String                    @default("available") @map("availability_status")
  savedLocationsJson                  String?                   @map("saved_locations_json")
  hiringNeedsJson                     String?                   @map("hiring_needs_json")
  authProvider                        String                    @default("LOCAL") @map("auth_provider")
  isActive                            Boolean                   @default(true) @map("is_active")
  lastLoginAt                         DateTime?                 @map("last_login_at")
  createdAt                           DateTime                  @default(now()) @map("created_at")
  updatedAt                           DateTime                  @updatedAt @map("updated_at")
  professionalLatitude                Float?                    @map("professional_latitude")
  professionalLongitude               Float?                    @map("professional_longitude")
  biometricEnabled                    Boolean                   @default(false) @map("biometric_enabled")
  biometricType                       String?                   @map("biometric_type")
  browserNotificationsEnabled         Boolean                   @default(true) @map("browser_notifications_enabled")
  emailNotificationsEnabled           Boolean                   @default(true) @map("email_notifications_enabled")
  emailVerifiedAt                     DateTime?                 @map("email_verified_at")
  projectActivityNotificationsEnabled Boolean                   @default(true) @map("project_activity_notifications_enabled")
  phoneVerifiedAt                     DateTime?                 @map("phone_verified_at")
  username                            String?                   @unique
  razorpayAccountId                   String?                   @unique @map("razorpay_account_id")
  razorpayContactId                   String?                   @map("razorpay_contact_id")
  professionalState                   String?                   @map("professional_state")
  professionalDistrict                String?                   @map("professional_district")
  professionalCategoryId              Int?                      @map("professional_category_id")
  clientJobs                          ClientJob[]
  clientProfiles                      ClientProfile?
  favoriteJobs                        FavoriteJob[]
  savedProfessionals                  SavedProfessional[]       @relation("ClientSavedProfessionals")
  savedByClients                      SavedProfessional[]       @relation("ProfessionalSavedByClients")
  clientPayments                      Payment[]                 @relation("PaymentClient")
  professionalPayments                Payment[]                 @relation("PaymentProfessional")
  clientProjectRequests               ProjectRequest[]          @relation("ProjectRequestClient")
  professionalProjectRequests         ProjectRequest[]          @relation("ProjectRequestProfessional")
  clientProjectTrackings              ProjectTracking[]         @relation("ProjectTrackingClient")
  professionalProjectTrackings        ProjectTracking[]         @relation("ProjectTrackingProfessional")
  professionalCategoryRecord          ServiceCategory?          @relation("ProfessionalPrimaryCategory", fields: [professionalCategoryId], references: [id])
  services                            Service[]                 @relation("ProfessionalServices")
  verification                        ProfessionalVerification?
  auditLogs                           AuditLog[]                @relation("AuditActor")
  personaVerifications                PersonaVerification[]
  sessions                            Session[]
  linkedAccounts                      UserLinkedAccount[]

  @@index([professionalState, professionalDistrict])
  @@index([professionalCategoryId])
  @@index([razorpayContactId])
}

model Session {
  id        String    @id @default(cuid())
  userId    Int       @map("user_id")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("sessions")
}

model ClientProfile {
  id                 Int                  @id @default(autoincrement())
  userId             Int                  @unique @map("user_id")
  fullName           String               @map("full_name")
  email              String
  phone              String
  companyName        String?              @map("company_name")
  companyWebsite     String?              @map("company_website")
  industry           String?
  teamSize           String?              @map("team_size")
  companyDescription String?              @map("company_description")
  address            String
  profilePhotoUrl    String?              @map("profile_photo_url")
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")
  hiringNeeds        ClientHiringNeed[]
  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  savedLocations     ClientSavedLocation?

  @@index([userId])
}

model ClientSavedLocation {
  id              Int           @id @default(autoincrement())
  clientProfileId Int           @unique(map: "ClientSavedLocation_one_primary_idx", where: raw("(\"isPrimary\" = true)")) @map("client_profile_id")
  label           String
  address         String
  createdAt       DateTime      @default(now()) @map("created_at")
  isPrimary       Boolean       @default(false) @map("is_primary")
  clientProfile   ClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)

  @@index([clientProfileId])
}

model ClientHiringNeed {
  id              Int           @id @default(autoincrement())
  clientProfileId Int           @map("client_profile_id")
  value           String
  createdAt       DateTime      @default(now()) @map("created_at")
  clientProfile   ClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)

  @@index([clientProfileId])
}

model ClientJob {
  id               Int                   @id @default(autoincrement())
  userId           Int                   @map("user_id")
  category         String?
  title            String?
  description      String?
  budgetMin        Int?                  @map("budget_min")
  budgetMax        Int?                  @map("budget_max")
  urgency          JobUrgency            @default(MEDIUM)
  jobDate          DateTime?             @map("job_date")
  deadline         DateTime?
  workMode         JobWorkMode           @default(BOTH) @map("work_mode")
  locationLabel    String?               @map("location_label")
  locationAddress  String?               @map("location_address")
  locationLat      Float?                @map("location_lat")
  locationLng      Float?                @map("location_lng")
  status           JobStatus             @default(OPEN)
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")
  hourlyRate       Int?                  @map("hourly_rate")
  totalJobHours    Int?                  @map("total_job_hours")
  timingType       String                @default("FIXED") @map("timing_type")
  paymentMethod    String                @default("WALLET") @map("payment_method")
  locationState    String?               @map("location_state")
  locationDistrict String?               @map("location_district")
  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  attachments      ClientJobAttachment[]
  favoriteJobs     FavoriteJob[]
  payments         Payment[]             @relation("PaymentJob")
  projectRequests  ProjectRequest[]
  projectTrackings ProjectTracking[]
  milestones       ClientJobMilestone[]

  @@index([userId])
  @@index([status])
  @@index([locationState, locationDistrict])
}

model FavoriteJob {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  jobId     Int       @map("job_id")
  createdAt DateTime  @default(now()) @map("created_at")
  job       ClientJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([userId])
  @@index([jobId])
}

model SavedProfessional {
  id             Int      @id @default(autoincrement())
  userId         Int      @map("user_id")
  professionalId Int      @map("professional_id")
  createdAt      DateTime @default(now()) @map("created_at")
  user           User     @relation("ClientSavedProfessionals", fields: [userId], references: [id], onDelete: Cascade)
  professional   User     @relation("ProfessionalSavedByClients", fields: [professionalId], references: [id], onDelete: Cascade)

  @@unique([userId, professionalId])
  @@index([userId])
  @@index([professionalId])
}

model ClientJobAttachment {
  id         Int       @id @default(autoincrement())
  jobId      Int       @map("job_id")
  fileName   String    @map("file_name")
  fileType   String?   @map("file_type")
  fileSize   Int?      @map("file_size")
  previewUrl String?   @map("preview_url")
  createdAt  DateTime  @default(now()) @map("created_at")
  job        ClientJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
}

model ClientJobMilestone {
  id           Int       @id @default(autoincrement())
  jobId        Int       @map("job_id")
  title        String
  description  String?
  percentage   Int
  amount       Int?
  validityDays Int       @default(0) @map("validity_days")
  sortOrder    Int       @default(0) @map("sort_order")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  job          ClientJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@map("ClientJobMilestone")
}

model ProjectTransaction {
  id             Int      @id @default(autoincrement())
  trackingId     Int      @map("tracking_id")
  milestoneId    Int?     @map("milestone_id")
  completionId   Int?     @map("completion_id")
  clientId       Int      @map("client_id")
  professionalId Int      @map("professional_id")
  amount         Int
  currency       String   @default("INR")
  type           String
  status         String   @default("COMPLETED")
  description    String
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([trackingId])
  @@index([clientId])
  @@index([professionalId])
  @@index([status])
  @@map("ProjectTransaction")
}

model ProjectNegotiation {
  id                    Int      @id @default(autoincrement())
  requestId             Int      @map("request_id")
  jobId                 Int      @map("job_id")
  clientId              Int      @map("client_id")
  professionalId        Int      @map("professional_id")
  senderId              Int      @map("sender_id")
  senderRole            String   @map("sender_role")
  bidAmount             Int?     @map("bid_amount")
  hourlyRate            Int?     @map("hourly_rate")
  totalJobHours         Int?     @map("total_job_hours")
  duration              String?
  message               String
  createdAt             DateTime @default(now()) @map("created_at")
  previousBidAmount     Int?     @map("previous_bid_amount")
  previousHourlyRate    Int?     @map("previous_hourly_rate")
  previousTotalJobHours Int?     @map("previous_total_job_hours")
  previousDuration      String?  @map("previous_duration")
  previousMessage       String?  @map("previous_message")

  @@index([requestId])
  @@index([clientId])
  @@index([professionalId])
  @@map("ProjectNegotiation")
}

model ProjectReview {
  id                     Int       @id @default(autoincrement())
  trackingId             Int       @unique @map("tracking_id")
  clientId               Int       @map("client_id")
  professionalId         Int       @map("professional_id")
  rating                 Int?
  comment                String?
  clientReviewedAt       DateTime? @map("client_reviewed_at")
  professionalRating     Int?      @map("professional_rating")
  professionalComment    String?   @map("professional_comment")
  professionalReviewedAt DateTime? @map("professional_reviewed_at")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")
  professionalResponse   String?   @map("professional_response")
  professionalResponseAt DateTime? @map("professional_response_at")

  @@index([clientId])
  @@index([professionalId])
  @@map("ProjectReview")
}

model ProjectRequest {
  id              Int              @id @default(autoincrement())
  jobId           Int              @map("job_id")
  clientId        Int              @map("client_id")
  professionalId  Int              @map("professional_id")
  bidAmount       Int              @map("bid_amount")
  hourlyRate      Int?             @map("hourly_rate")
  totalJobHours   Int?             @map("total_job_hours")
  duration        String
  coverLetter     String           @map("cover_letter")
  status          String           @default("PENDING")
  attachmentsJson String?          @default("[]") @map("attachments_json")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  origin          String           @default("CLIENT_HIRE")
  client          User             @relation("ProjectRequestClient", fields: [clientId], references: [id])
  job             ClientJob        @relation(fields: [jobId], references: [id])
  professional    User             @relation("ProjectRequestProfessional", fields: [professionalId], references: [id])
  tracking        ProjectTracking?

  @@index([jobId])
  @@index([clientId])
  @@index([professionalId])
  @@map("ProjectRequest")
}

model ProjectTracking {
  id             Int                    @id @default(autoincrement())
  requestId      Int                    @unique @map("request_id")
  jobId          Int                    @map("job_id")
  clientId       Int                    @map("client_id")
  professionalId Int                    @map("professional_id")
  status         String                 @default("READY_TO_START")
  acceptedAt     DateTime               @default(now()) @map("accepted_at")
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")
  progress       Int                    @default(0)
  currentStage   String?                @map("current_stage")
  startedAt      DateTime?              @map("started_at")
  completedAt    DateTime?              @map("completed_at")
  payments       Payment[]              @relation("PaymentProjectTracking")
  milestones     ProjectMilestone[]
  timelineEvents ProjectTimelineEvent[]
  client         User                   @relation("ProjectTrackingClient", fields: [clientId], references: [id])
  job            ClientJob              @relation(fields: [jobId], references: [id])
  professional   User                   @relation("ProjectTrackingProfessional", fields: [professionalId], references: [id])
  request        ProjectRequest         @relation(fields: [requestId], references: [id])
  workUploads    ProjectWorkUpload[]

  @@index([jobId])
  @@index([clientId])
  @@index([professionalId])
  @@map("ProjectTracking")
}

model ProjectTimelineEvent {
  id             Int             @id @default(autoincrement())
  trackingId     Int             @map("tracking_id")
  milestoneId    Int?            @map("milestone_id")
  actorId        Int             @map("actor_id")
  actorRole      String          @map("actor_role")
  type           String
  title          String
  description    String?
  progress       Int?
  stage          String?
  attachmentJson String?         @default("[]") @map("attachment_json")
  createdAt      DateTime        @default(now()) @map("created_at")
  tracking       ProjectTracking @relation(fields: [trackingId], references: [id])

  @@index([trackingId, createdAt])
  @@map("ProjectTimelineEvent")
}

model ProjectMilestone {
  id                Int                 @id @default(autoincrement())
  trackingId        Int                 @map("tracking_id")
  clientId          Int                 @map("client_id")
  professionalId    Int                 @map("professional_id")
  title             String
  description       String?
  amount            Int
  dueDate           DateTime?           @map("due_date")
  status            String              @default("UPCOMING")
  validityDays      Int                 @default(0) @map("validity_days")
  releaseAt         DateTime?           @map("release_at")
  autoReleaseStatus String?             @map("auto_release_status")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")
  submittedAt       DateTime?           @map("submitted_at")
  approvedAt        DateTime?           @map("approved_at")
  tracking          ProjectTracking     @relation(fields: [trackingId], references: [id])
  payment           Payment?
  workUploads       ProjectWorkUpload[]

  @@index([trackingId])
  @@map("ProjectMilestone")
}

model ProjectWorkUpload {
  id          Int               @id @default(autoincrement())
  trackingId  Int               @map("tracking_id")
  roundNumber Int               @default(1) @map("round_number")
  title       String
  note        String?
  fileName    String?           @map("file_name")
  fileUrl     String?           @map("file_url")
  filesJson   String?           @default("[]") @map("files_json")
  createdAt   DateTime          @default(now()) @map("created_at")
  milestoneId Int?              @map("milestone_id")
  status      String            @default("UPLOADED")
  milestone   ProjectMilestone? @relation(fields: [milestoneId], references: [id], onDelete: Restrict)
  tracking    ProjectTracking   @relation(fields: [trackingId], references: [id])

  @@index([trackingId])
  @@map("ProjectWorkUpload")
}

model SocketConversation {
  id             String                    @id
  userAId        Int                       @map("user_a_id")
  userBId        Int                       @map("user_b_id")
  userAName      String                    @map("user_a_name")
  userBName      String                    @map("user_b_name")
  userAAvatarUrl String?                   @map("user_a_avatar_url")
  userBAvatarUrl String?                   @map("user_b_avatar_url")
  job            String                    @default("Direct message")
  createdAt      DateTime                  @default(now()) @map("created_at")
  updatedAt      DateTime                  @updatedAt @map("updated_at")
  clears         SocketConversationClear[]
  messages       SocketMessage[]

  @@index([userAId])
  @@index([userBId])
}

model SocketMessage {
  id             String             @id
  conversationId String             @map("conversation_id")
  senderId       Int                @map("sender_id")
  receiverId     Int                @map("receiver_id")
  body           String
  kind           String             @default("text")
  createdAt      DateTime           @default(now()) @map("created_at")
  readAt         DateTime?          @map("read_at")
  conversation   SocketConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
  @@index([receiverId])
}

model SocketConversationClear {
  conversationId String             @map("conversation_id")
  userId         Int                @map("user_id")
  clearedAt      DateTime           @default(now()) @map("cleared_at")
  conversation   SocketConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
}

model CallSession {
  conversationId String   @id @map("conversation_id")
  startedBy      Int      @map("started_by")
  mode           String
  status         String   @default("PENDING")
  offerSdp       String?  @map("offer_sdp")
  answerSdp      String?  @map("answer_sdp")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
}

model MessageConversation {
  id             String    @id @default(cuid())
  clientId       Int       @map("client_id")
  professionalId Int       @map("professional_id")
  contractId     String?   @map("contract_id")
  jobTitle       String?   @map("job_title")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  lastMessageAt  DateTime? @map("last_message_at")
  messages       Message[]

  @@index([clientId])
  @@index([professionalId])
}

model Message {
  id             String              @id @default(cuid())
  conversationId String              @map("conversation_id")
  senderId       Int                 @map("sender_id")
  body           String
  createdAt      DateTime            @default(now()) @map("created_at")
  readAt         DateTime?           @map("read_at")
  conversation   MessageConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
}

model UserNotification {
  id          Int       @id @default(autoincrement())
  userId      Int       @map("user_id")
  type        String
  title       String
  description String?
  href        String?
  createdAt   DateTime  @default(now()) @map("created_at")
  readAt      DateTime? @map("read_at")
  clearedAt   DateTime? @map("cleared_at")

  @@index([userId])
  @@index([createdAt])
}

model UserNotificationState {
  userId          Int       @map("user_id")
  notificationKey String    @map("notification_key")
  readAt          DateTime? @map("read_at")
  clearedAt       DateTime? @map("cleared_at")

  @@id([userId, notificationKey])
}

model Payment {
  id                       Int               @id @default(autoincrement())
  clientId                 Int               @map("client_id")
  professionalId           Int               @map("professional_id")
  jobId                    Int?              @map("job_id")
  amount                   Int
  commissionAmount         Int               @default(0) @map("commission_amount")
  currency                 String            @default("INR")
  provider                 String
  providerReference        String?           @map("provider_reference")
  status                   String            @default("PENDING")
  idempotencyKey           String            @unique @map("idempotency_key")
  createdAt                DateTime          @default(now()) @map("created_at")
  updatedAt                DateTime          @updatedAt @map("updated_at")
  razorpayOrderId          String?           @unique @map("razorpay_order_id")
  razorpayPaymentId        String?           @unique @map("razorpay_payment_id")
  razorpaySignature        String?           @map("razorpay_signature")
  projectTrackingId        Int?              @map("project_tracking_id")
  milestoneId              Int?              @unique @map("milestone_id")
