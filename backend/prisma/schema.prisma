enum UserRole {
  ADMIN
  CLIENT
  PROFESSIONAL
}

enum JobUrgency {
  LOW
  MEDIUM
  HIGH
}

enum JobWorkMode {
  ON_SITE
  REMOTE
  BOTH
}

enum JobStatus {
  DRAFT
  OPEN
  CLOSED
}

enum CmsPageStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum EmailAudience {
  CLIENT
  PROFESSIONAL
  ADMIN
  SYSTEM
}

model EmailTemplate {
  id           Int           @id @default(autoincrement())
  key          String        @unique
  name         String
  description  String        @default("")
  audience     EmailAudience @default(CLIENT)
  category     String        @default("General")
  subject      String
  heading      String
  bodyText     String
  actionText   String?
  actionUrl    String?
  isActive     Boolean       @default(true)
  isCustomized Boolean       @default(false)
  updatedBy    Int?          @map("updated_by")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@index([audience])
  @@index([category])
  @@map("email_templates")
}

model PlatformSetting {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  value       String
  description String?  @default("")
  category    String   @default("GENERAL")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([category])
  @@map("platform_settings")
}

model SmsTemplate {
  id            Int           @id @default(autoincrement())
  key           String        @unique
  name          String
  description   String        @default("")
  audience      EmailAudience @default(CLIENT)
  category      String        @default("General")
  bodyText      String
  dltTemplateId String?       @map("dlt_template_id")
  senderId      String?       @map("sender_id")
  isActive      Boolean       @default(true)
  isCustomized  Boolean       @default(false)
  updatedBy     Int?          @map("updated_by")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  @@index([audience])
  @@index([category])
  @@map("sms_templates")
}

model UserLinkedAccount {
  id                    Int      @id @default(autoincrement())
  userId                Int      @map("user_id")
  accountType           String   @map("account_type")
  accountHolder         String?  @map("account_holder")
  accountNumber         String?  @map("account_number")
  last4                 String?  @map("last_4")
  ifscCode              String?  @map("ifsc_code")
  bankName              String?  @map("bank_name")
  upiId                 String?  @map("upi_id")
  cardBank              String?  @map("card_bank")
  razorpayAccountId     String?  @map("razorpay_account_id")
  razorpayFundAccountId String?  @map("razorpay_fund_account_id")
  isDefault             Boolean  @default(false) @map("is_default")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isDefault])
  @@index([razorpayFundAccountId])
  @@index([upiId])
  @@map("user_linked_accounts")
}
