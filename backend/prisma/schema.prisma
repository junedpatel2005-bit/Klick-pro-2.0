  description    String
  price          Int?
  imageUrl       String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  category       ServiceCategory @relation(fields: [categoryId], references: [id])
  professional   User            @relation("ProfessionalServices", fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([professionalId])
}

model PageConfiguration {
  id              Int       @id @default(autoincrement())
  pageId          String
  config          String
  publishedConfig String?
  status          String    @default("DRAFT")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  publishedAt     DateTime?

  @@index([pageId])
  @@map("page_configurations")
}

model WebsitePageOverride {
  id        Int      @id @default(autoincrement())
  title     String
  path      String
  html      String?
  css       String?
  status    String   @default("DRAFT")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("website_page_overrides")
}

model PageTextOverride {
  pagePath   String
  elementKey String
  text       String
  updatedAt  DateTime

  @@id([pagePath, elementKey])
  @@map("page_text_overrides")
}

model LegacyUser {
