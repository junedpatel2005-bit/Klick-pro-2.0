{
  "name": "klick-pro",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-all.mjs",
    "dev:webpack": "cross-env NEXT_WEBPACK=1 node server.mjs",
    "build": "prisma migrate deploy && next build",
    "start": "cross-env NODE_ENV=production node server.mjs",
    "lint": "eslint . --cache",
    "typecheck": "tsc --noEmit",
    "test:resilience": "node --conditions=react-server --import tsx scripts/test-razorpay-resilience.ts",
    "db:backup": "node --conditions=react-server --import tsx scripts/backup-database.ts",
    "db:restore": "node --conditions=react-server --import tsx scripts/backup-database.ts --restore",
    "check:razorpay": "tsx scripts/check-razorpay-sandbox.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed-categories": "tsx scripts/seed-category-hierarchy.ts",
    "db:add-subcategory-jobs": "tsx scripts/add-faker-subcategory-jobs.ts",
    "db:add-juned-jobs": "tsx scripts/add-faker-jobs-for-juned.ts",
    "db:add-faker-clients": "tsx scripts/add-faker-clients.ts",
    "db:post-faker-jobs": "tsx scripts/post-faker-jobs-for-all-clients.ts",
    "format": "prettier --write .",
    "dev:all": "node scripts/dev-all.mjs",
    "dev:backend": "cross-env PORT=5000 node backend/server.mjs",
    "dev:frontend": "cross-env PORT=3000 node frontend/server.mjs",
    "dev:single": "node server.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1110.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-google-maps/api": "^2.20.7",
    "@react-pdf/renderer": "^4.6.1",
    "@sentry/core": "^10.70.0",
    "@sentry/nextjs": "^10.70.0",
    "@tanstack/react-query": "^5.83.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.2",
    "india-states-districts": "^1.8.0",
    "jose": "^6.2.8",
    "lucide-react": "^0.575.0",
    "next": "^16.1.6",
    "nodemailer": "^9.0.5",
    "pg": "^8.23.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.71.2",
    "react-loading-skeleton": "^3.5.0",
    "server-only": "^0.0.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.3.4",
    "twilio": "^6.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@faker-js/faker": "^10.5.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.16.5",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.32.0",
    "eslint-config-next": "^16.1.6",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.9.0",
    "prettier": "^3.7.3",
    "prisma": "^7.9.1",
    "tsx": "^4.23.11",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1"
  },
  "overrides": {
    "lodash-es": "4.18.1"
  },
  "optionalDependencies": {
    "@next/swc-win32-x64-msvc": "^16.3.0"
  },
  "engines": {
    "node": ">=22 <23"
  }
}
